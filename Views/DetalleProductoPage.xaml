<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EscobarMatias_DesarrolloAppMovil_II.Views.DetalleProductoPage"
             Title="DetalleProductoPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Estado de error: id nulo/inválido o producto inexistente en los mocks -->
            <Border StrokeShape="RoundRectangle 14" Padding="16" Stroke="Transparent"
                    BackgroundColor="#FFEBEE" IsVisible="{Binding TieneError}">
                <Label Text="{Binding MensajeError}" TextColor="#D32F2F" FontAttributes="Bold" />
            </Border>

            <!-- Contenido normal: solo se muestra si el producto se encontró -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding TieneProducto}">

                <Border StrokeShape="RoundRectangle 20" Stroke="Transparent" HeightRequest="220">
                    <Image Source="{Binding Producto.ImagenUrl}" Aspect="AspectFill" />
                </Border>

                <Label Text="{Binding Producto.Nombre}" FontSize="24" FontAttributes="Bold" />
                <Label Text="{Binding Producto.Descripcion}"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                <Label Text="{Binding Producto.Precio, StringFormat='$ {0:N2}'}"
                       FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Primary}" />

                <Button Text="Comprar" Command="{Binding AbrirConfirmacionCommand}" Margin="0,10,0,0" />
                <Button Text="Volver al catálogo" Command="{Binding VolverCommand}"
                        BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>
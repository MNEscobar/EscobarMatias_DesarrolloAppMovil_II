<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EscobarMatias_DesarrolloAppMovil_II.Views.ConfirmacionModalPage"
             Shell.PresentationMode="ModalAnimated"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
             Title="ConfirmacionModalPage">
    
    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

        <Label Text="Confirmar acción" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
        <Label Text="{Binding Mensaje}" FontSize="16" HorizontalOptions="Center" HorizontalTextAlignment="Center" />

        <HorizontalStackLayout Spacing="12" HorizontalOptions="Center" Margin="0,20,0,0">
            <Button Text="No" Command="{Binding CancelarCommand}"
                    BackgroundColor="Transparent" TextColor="{StaticResource Primary}" WidthRequest="120" />
            <Button Text="Sí" Command="{Binding ConfirmarCommand}" WidthRequest="120" />
        </HorizontalStackLayout>

    </VerticalStackLayout>
    
</ContentPage>